# PostgreSQL connection (matches docker-compose.yml).
DATABASE_URL="postgresql://rodovo:rodovo@localhost:5432/rodovo?schema=public"

# Optional: enable Redis-backed rate limiting (needed only when running the app
# as more than one instance). Matches the redis service in docker-compose.yml.
# REDIS_URL="redis://localhost:6379"

# Set to "true" only when the app runs behind a reverse proxy that overwrites
# the x-forwarded-for header. Enables per-IP rate limiting. Leave unset locally.
TRUST_PROXY_HEADERS="false"
