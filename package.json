{
  "name": "family-tree",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d db",
    "redis:up": "docker compose up -d redis",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.mjs",
    "test": "prisma generate && tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.3.3",
    "prisma": "^6.8.2",
    "tsx": "^4.22.3",
    "typescript": "5.8.3"
  }
}
