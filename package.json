{
  "name": "family-tree",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.19.0",
    "npm": "10.9.3"
  },
  "packageManager": "npm@10.9.3",
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d db",
    "redis:up": "docker compose up -d redis",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.mjs",
    "test": "tsx scripts/run-tests.ts",
    "test:integration": "tsx scripts/run-tests.ts integration",
    "typecheck": "tsc --noEmit --incremental false",
    "ci:database": "tsx scripts/ci-database.ts",
    "test:smoke": "tsx scripts/ops-smoke.ts",
    "test:upgrade": "tsx scripts/legacy-upgrade.ts",
    "test:recovery": "tsx scripts/recovery-drill.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "next": "15.5.26",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "prisma": "^6.8.2",
    "tsx": "^4.22.3",
    "typescript": "5.8.3"
  }
}
